---
import { t } from '@cms/kit/content';
import { T } from '@cms/kit/components';
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <T k="hero.title" as="h1" />
      <T k="hero.lede" as="p" class="lede" />
      <div class="ctas">
        <a class="btn primary" href="https://github.com/getsupraman/supraman/releases/latest">{t('hero.cta')}</a>
        <a class="btn ghost" href={`${base}#story`}>{t('hero.cta2')}</a>
      </div>
      <p class="fine">{t('hero.fine')}</p>
    </div>

    <figure class="claim" data-reveal="load" role="img" aria-label={t('hero.sk.label')}>
      <div class="term" aria-hidden="true">
        <div class="term-bar"><span class="tab"><span class="dot" style="display:inline-block;margin-right:8px"></span>{t('ch2.demo.a')}</span></div>
        <div class="term-body">
          <div class="ln" style="--d:.2s"><span class="gt">&gt;</span><span>{t('hero.sk.prompt')}</span></div>
          <div class="ln" style="--d:.9s"><span class="bot">●</span>
            <span class="said">{t('hero.sk.claim')}<span class="strike"></span>
              <svg class="pen ink" viewBox="0 0 200 40" preserveAspectRatio="none" style="inset:auto;left:-16px;top:-12px;width:calc(100% + 32px);height:calc(100% + 24px)">
                <path pathLength="1" style="--d:1.6s;--dur:.9s" stroke="#f5a524" stroke-width="2.2" d="M150 5 C 90 0, 12 4, 5 19 C 0 33, 60 39, 108 38 C 168 37, 199 30, 196 16 C 193 6, 168 2, 128 5" />
              </svg>
            </span>
          </div>
          <div class="ln" style="--d:3.9s"><span class="bad">✕</span><span class="bad">{t('hero.sk.refused')}</span></div>
          <div class="ln" style="--d:4.9s"><span class="ok">✓</span><span class="ok">{t('hero.sk.verify')}</span></div>
        </div>
      </div>
      <p class="note doubt" style="--d:2.3s">{t('hero.sk.doubt')}</p>
      <p class="note proof" style="--d:5.7s">
        <svg class="ink" viewBox="0 0 40 30" width="34" height="26" style="display:inline-block;vertical-align:-4px;margin-right:6px"><path pathLength="1" style="--d:5.7s;--dur:.5s" stroke="#6cc890" stroke-width="3.5" d="M4 16 L15 26 L37 3" /></svg>{t('hero.sk.done')}
      </p>
    </figure>
  </div>
</section>
