---
import { t } from '@cms/kit/content';
const base = import.meta.env.BASE_URL;
---
<header class="top">
  <div class="wrap top-row">
    <a class="brand" href={base} aria-label={t('site.home')}>
      <img src={`${base}brand/supraman-lockup-on-dark.svg`} alt={t('site.logo_alt')} width="186" height="34" />
    </a>
    <nav class="nav" aria-label={t('nav.label')}>
      <a href={`${base}#story`}>{t('nav.story')}</a>
      <a href={`${base}#little`}>{t('nav.little')}</a>
      <a href="https://github.com/getsupraman">{t('nav.github')}</a>
      <a class="nav-cta" href={`${base}#get`}>{t('nav.get')}</a>
    </nav>
  </div>
</header>
