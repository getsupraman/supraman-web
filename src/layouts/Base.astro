---
import '../styles/global.css';
import { locale, t } from '@cms/kit/content';
import { SeoHead } from '@cms/kit/components';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description?: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#181818" />
    <meta name="color-scheme" content="dark" />
    <SeoHead title={title} description={description ?? t('site.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? t('site.description')} />
    <meta property="og:image" content={new URL(`${base}brand/social-card.png`, Astro.site ?? 'https://supraman.ai').href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}brand/supraman.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}brand/supraman-1024.png`} />
    <link rel="preload" href={`${base}fonts/archivo-var.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/kalam-400.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-zoom-label={t('ui.zoom')} data-close-label={t('ui.close')}>
    <a class="skip" href="#main">{t('site.skip')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.js"></script>
  </body>
</html>
