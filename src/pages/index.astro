---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Chapter from '../components/Chapter.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { t } from '@cms/kit/content';
import { T } from '@cms/kit/components';

const base = import.meta.env.BASE_URL;
const shot = (name: string) => `${base}shots/${name}`;
const typed = t('ch2.demo.typed');
const little = ['reopen', 'undo', 'merge', 'lines', 'inbox', 'reboot', 'theme', 'native', 'update'];
---
<Base title={t('site.title')}>
  <Hero />

  <div class="story" id="story" aria-label={t('spine.label')}>
    <div class="spine" aria-hidden="true"><div class="spine-fill"></div></div>
    <div class="wrap">

      <HowItWorks />

      <Chapter id="crew">
        <Fragment slot="text">
          <T k="ch1.title" as="h2" id="crew-h" />
          <T k="ch1.body" as="p" />
          <div class="sketch" aria-hidden="true">
            <svg viewBox="0 0 360 230">
              <g class="ink" stroke="#8b8b8b" stroke-width="2">
                <path pathLength="1" style="--d:.1s" d="M18 42 L168 38 L171 132 L21 136 Z M19 60 L169 57" />
                <path pathLength="1" style="--d:.35s" d="M120 72 L280 76 L277 170 L118 166 Z M119 90 L279 94" />
                <path pathLength="1" style="--d:.6s" d="M58 122 L208 118 L212 208 L60 212 Z M59 140 L210 136" />
              </g>
              <g class="ink" stroke="#f5a524" stroke-width="2.4">
                <path pathLength="1" style="--d:1.1s;--dur:1.6s" d="M232 196 C 300 220, 350 170, 318 130 S 220 120, 262 90 S 360 70, 330 30 S 250 10, 236 40" />
              </g>
              <text x="250" y="222" fill="#f5a524" font-family="Kalam, cursive" font-size="17" class="svg-note" transform="rotate(-3 250 222)">{t('ch1.sk.where')}</text>
              <text x="70" y="182" fill="#8b8b8b" font-family="Kalam, cursive" font-size="16" transform="rotate(-2 70 182)">{t('ch1.sk.lost')}</text>
            </svg>
          </div>
        </Fragment>
        <figure class="shot side-notes" slot="visual" data-zoom>
          <div class="frame">
            <img src={shot('tree.webp')} srcset={`${shot('tree-640.webp')} 640w, ${shot('tree.webp')} 920w`} sizes="(min-width: 980px) 390px, 58vw" alt={t('ch1.alt')} width="920" height="2000" loading="lazy" decoding="async" />
          </div>
          <svg class="pen ink" viewBox="0 0 1600 2000" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" style="--d:.4s" stroke="#f5a524" stroke-width="6" d="M935 170 C 965 200, 950 380, 975 390 C 950 400, 965 580, 935 610" />
            <path pathLength="1" style="--d:1s" stroke="#f5a524" stroke-width="6" d="M935 812 C 965 840, 950 890, 975 900 C 950 910, 965 960, 935 988" />
            <path pathLength="1" style="--d:1.6s" stroke="#f5a524" stroke-width="6" d="M935 1640 C 965 1680, 950 1800, 975 1810 C 950 1820, 965 1950, 935 1980" />
          </svg>
          <p class="note" style="left:63%;top:19%;--d:.8s">{t('ch1.note.inbox')}</p>
          <p class="note" style="left:63%;top:43%;--d:1.4s;--rot:2deg">{t('ch1.note.waiting')}</p>
          <p class="note" style="left:63%;top:83%;--d:2s;--rot:-3deg">{t('ch1.note.tree')}</p>
        </figure>
      </Chapter>

      <Chapter id="talk" flip>
        <Fragment slot="text">
          <T k="ch2.title" as="h2" id="talk-h" />
          <T k="ch2.body" as="p" />
        </Fragment>
        <figure class="shot drag" slot="visual" data-reveal role="img" aria-label={t('ch2.demo.label')}>
          <div class="frame app" aria-hidden="true" style={`--n:${typed.length};--dx:150px;--dy:120px`}>
            <div class="app-tabs">
              <span class="app-tab"><span class="dot"></span>{t('ch2.demo.a')}</span>
              <span class="app-tab on"><span class="dot idle"></span>{t('ch2.demo.b')}</span>
              <span class="app-tab"><span class="dot idle"></span>{t('ch2.demo.c')}</span>
            </div>
            <div class="app-term">
              <div class="prompt"><span class="dim">&gt;</span>
                <span class="ask-wrap">{t('ch2.demo.ask')} <span class="pasted">{t('ch2.demo.a')}</span> <span class="typed">{typed}</span></span><span class="caret"></span>
              </div>
              <div class="dropzone">{t('ch2.demo.drop')}</div>
            </div>
            <span class="ghost-tab"><span class="dot"></span>{t('ch2.demo.a')}</span>
            <svg class="cursor" viewBox="0 0 18 22" style="left:12px;top:10px"><path d="M2 2 L2 18 L6.5 14 L9.5 20.5 L12 19.4 L9 13 L15 13 Z" fill="#ececec" stroke="#181818" stroke-width="1.4" stroke-linejoin="round" /></svg>
          </div>
          <p class="note" style="right:4%;bottom:-38px;--d:.6s;--rot:-3deg">{t('ch2.note')}</p>
        </figure>
      </Chapter>

      <Chapter id="review" wide>
        <Fragment slot="text">
          <T k="ch3.title" as="h2" id="review-h" />
          <T k="ch3.body" as="p" />
          <T k="ch3.undo" as="p" class="aside" />
          <div class="toggle" role="group" aria-label={t('ch3.toggle.label')} data-views="review-shot">
            <button type="button" aria-pressed="true" data-view="graph">{t('ch3.toggle.graph')}</button>
            <button type="button" aria-pressed="false" data-view="session">{t('ch3.toggle.session')}</button>
            <button type="button" aria-pressed="false" data-view="diff">{t('ch3.toggle.diff')}</button>
          </div>
        </Fragment>
        <figure class="shot views" slot="visual" id="review-shot" data-view="graph" data-reveal data-zoom>
          <div class="frame">
            {[['graph', 'ch3.alt'], ['session', 'ch3.alt2'], ['diff', 'ch3.alt3']].map(([v, k]) => (
              <img data-v={v} src={shot(`git-${v}.webp`)} srcset={`${shot(`git-${v}-1280.webp`)} 1280w, ${shot(`git-${v}.webp`)} 2360w`} sizes="(min-width: 1240px) 1180px, 100vw" alt={t(k)} width="2360" height="1934" loading="lazy" decoding="async" />
            ))}
          </div>
          <svg class="pen ink" viewBox="0 0 2360 1934" preserveAspectRatio="none" aria-hidden="true">
            <g data-v="graph">
              <path pathLength="1" style="--d:.4s" stroke="#f5a524" stroke-width="6" d="M1000 186 C 800 176, 524 184, 520 240 C 516 294, 800 300, 1000 294 C 1090 290, 1092 194, 1020 186" />
              <path pathLength="1" style="--d:1s;--dur:.5s" stroke="#f5a524" stroke-width="6" d="M1290 242 C 1230 242, 1150 242, 1080 242 M1104 222 L1078 242 L1106 262" />
              <path pathLength="1" style="--d:1.5s" stroke="#f5a524" stroke-width="6" d="M1000 854 C 820 846, 616 856, 612 910 C 608 964, 820 972, 1000 968 C 1100 964, 1104 862, 1030 854" />
              <path pathLength="1" style="--d:2.1s;--dur:.5s" stroke="#f5a524" stroke-width="6" d="M1290 912 C 1230 912, 1160 912, 1104 912 M1128 892 L1102 912 L1130 932" />
            </g>
            <g data-v="session">
              <path pathLength="1" style="--d:.2s" stroke="#f5a524" stroke-width="6" d="M1840 1800 C 1780 1794, 1722 1802, 1720 1832 C 1718 1862, 1790 1866, 1846 1862 C 1880 1858, 1878 1806, 1840 1800" />
              <path pathLength="1" style="--d:.8s;--dur:.5s" stroke="#f5a524" stroke-width="6" d="M1560 1832 C 1620 1832, 1670 1832, 1706 1832 M1684 1812 L1708 1832 L1682 1852" />
            </g>
            <g data-v="diff">
              <path pathLength="1" style="--d:.2s" stroke="#f5a524" stroke-width="6" d="M1840 1172 C 1720 1166, 1536 1174, 1532 1204 C 1528 1234, 1700 1240, 1850 1234 C 1904 1230, 1900 1178, 1840 1172" />
              <path pathLength="1" style="--d:.8s;--dur:.5s" stroke="#f5a524" stroke-width="6" d="M1330 1290 C 1400 1270, 1460 1240, 1514 1214 M1490 1204 L1516 1212 L1502 1238" />
            </g>
          </svg>
          <p class="note" data-v="graph" style="left:55%;top:10%;--d:1.2s;--rot:-2deg">{t('ch3.note.click')}</p>
          <p class="note" data-v="graph" style="left:55%;top:44.5%;--d:2.3s;--rot:2deg">{t('ch3.note.agent')}</p>
          <p class="note" data-v="session" style="left:41%;top:92%;--d:1s;--rot:-2deg">{t('ch3.note.open')}</p>
          <p class="note" data-v="diff" style="left:36%;top:67%;--d:1s;--rot:-3deg">{t('ch3.note.stage')}</p>
        </figure>
      </Chapter>

      <Chapter id="proof" flip>
        <Fragment slot="text">
          <T k="ch4.title" as="h2" id="proof-h" />
          <T k="ch4.body" as="p" />
        </Fragment>
        <div slot="visual">
          <figure class="term proof-term" data-reveal role="img" aria-label={t('ch4.term.label')} style="margin:0">
            <div class="term-body" aria-hidden="true">
              <div class="ln" style="--d:.1s"><span class="gt">&gt;</span><span>{t('ch4.term.l1')}</span></div>
              <div class="ln" style="--d:.6s"><span class="bad">✕</span><span class="bad">{t('ch4.term.l2')}</span></div>
              <div class="ln ind" style="--d:.9s"><span class="dim">-</span> {t('ch4.term.l3')}</div>
              <div class="ln ind" style="--d:1.1s"><span class="dim">-</span> {t('ch4.term.l4')}</div>
              <div class="ln ind" style="--d:1.4s;color:#4daafc">{t('ch4.term.l5')}</div>
              <div class="gap"></div>
              <div class="ln" style="--d:2.2s"><span class="gt">&gt;</span><span>{t('ch4.term.l6')}</span></div>
              <div class="ln ind ok" style="--d:2.8s">{t('ch4.term.l7')}</div>
              <div class="ln" style="--d:3.4s"><span class="gt">&gt;</span><span>{t('ch4.term.l8')}</span></div>
              <div class="ln ok" style="--d:3.9s"><span>✓</span><span>{t('ch4.term.l9')}</span></div>
            </div>
          </figure>
          <figure class="shot dash-shot" data-zoom>
            <div class="frame"><img src={shot('wm-item.webp')} srcset={`${shot('wm-item-800.webp')} 800w, ${shot('wm-item.webp')} 1363w`} sizes="(min-width: 980px) 640px, 100vw" alt={t('ch4.alt')} width="1363" height="1420" loading="lazy" decoding="async" /></div>
            <svg class="pen ink" viewBox="0 0 1363 1420" preserveAspectRatio="none" aria-hidden="true">
              <path pathLength="1" style="--d:.4s" stroke="#6cc890" stroke-width="5" d="M820 670 C 780 664, 716 670, 714 696 C 712 722, 780 726, 840 722 C 868 718, 866 674, 820 670" />
              <path pathLength="1" style="--d:1s;--dur:.6s" stroke="#6cc890" stroke-width="5" d="M1010 1110 C 1060 960, 960 800, 852 718 M860 748 L850 716 L884 718" />
              <path pathLength="1" style="--d:1.6s;--dur:.5s" stroke="#f5a524" stroke-width="5" d="M770 1300 C 730 1300, 700 1300, 672 1300 M694 1282 L670 1300 L694 1318" />
            </svg>
            <p class="note" style="left:58%;top:79%;--d:1.2s;--rot:-2deg;color:#6cc890">{t('ch4.note.proof')}</p>
            <p class="note" style="left:58%;top:88.5%;--d:1.8s;--rot:2deg">{t('ch4.note.claim')}</p>
          </figure>
        </div>
      </Chapter>

      <Chapter id="memory">
        <Fragment slot="text">
          <T k="ch5.title" as="h2" id="memory-h" />
          <T k="ch5.body" as="p" />
        </Fragment>
        <figure class="shot memory" slot="visual" role="img" aria-label={t('ch5.sk.label')}>
          <svg viewBox="0 0 520 330" aria-hidden="true" style="overflow:visible">
            <text x="24" y="38" fill="#8b8b8b" font-family="Archivo, sans-serif" font-size="15">{t('ch5.sk.context')}</text>
            <rect class="ctx-fill" x="24" y="50" width="330" height="34" rx="6" fill="#4daafc" opacity=".55" />
            <g class="ink" stroke="#cccccc" stroke-width="2"><path pathLength="1" d="M24 50 L356 48 L355 85 L23 84 Z" /></g>
            <text class="ctx-cut" x="372" y="74" fill="#f0787a" font-family="Kalam, cursive" font-size="20">{t('ch5.sk.compacted')}</text>
            <text class="ctx-cut" x="40" y="128" fill="#8b8b8b" font-family="Kalam, cursive" font-size="19" transform="rotate(-2 40 128)" style="transition-delay:2.4s">{t('ch5.sk.forgot')}</text>
            <g class="ink" stroke="#f5a524" stroke-width="2.4">
              <path pathLength="1" style="--d:2.8s" d="M40 160 L496 156 L500 318 L44 322 Z" />
              <path pathLength="1" style="--d:3.4s;--dur:.6s" d="M60 222 L480 219 M60 268 L480 265" />
            </g>
            <text class="ctx-brief" x="62" y="196" fill="#f5a524" font-family="Cascadia Code, monospace" font-size="17">{t('ch5.sk.brief')}</text>
            <g class="ctx-brief" font-family="Archivo, sans-serif" font-size="16">
              <text x="62" y="246" fill="#8b8b8b">{t('ch5.sk.goal')}</text><text x="160" y="246" fill="#ece7d8">{t('ch5.sk.goal_v')}</text>
              <text x="62" y="292" fill="#8b8b8b">{t('ch5.sk.rules')}</text><text x="160" y="292" fill="#ece7d8">{t('ch5.sk.rules_v')}</text>
              <text x="330" y="292" fill="#8b8b8b">{t('ch5.sk.next')}</text><text x="376" y="292" fill="#4daafc" font-family="Cascadia Code, monospace" font-size="14">{t('ch5.sk.next_v')}</text>
            </g>
          </svg>
        </figure>
      </Chapter>

      <Chapter id="loops" flip>
        <Fragment slot="text">
          <T k="ch6.title" as="h2" id="loops-h" />
          <T k="ch6.body" as="p" />
          <pre class="code"><span class="c">{t('ch6.code.c1')}</span>
<span class="k">{t('ch6.code.l1')}</span> \
  {t('ch6.code.l2')} \
  {t('ch6.code.l3')}
<span class="c">{t('ch6.code.c2')}</span></pre>
        </Fragment>
        <figure class="shot loops" slot="visual" style="max-width:640px;margin-inline:auto" data-zoom>
          <div class="frame fade-right">
            <img src={shot('schedule.webp')} srcset={`${shot('schedule-1280.webp')} 1280w, ${shot('schedule.webp')} 1580w`} sizes="(min-width: 980px) 640px, 100vw" alt={t('ch6.alt')} width="1580" height="1934" loading="lazy" decoding="async" />
          </div>
          <svg class="pen ink" viewBox="0 0 1580 1934" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" style="--d:.4s" stroke="#f5a524" stroke-width="6" d="M690 372 C 720 400, 705 425, 730 434 C 705 444, 720 470, 690 496" />
            <path pathLength="1" style="--d:1.2s" stroke="#f5a524" stroke-width="6" d="M160 1858 C 110 1852, 46 1858, 44 1886 C 42 1914, 110 1918, 172 1914 C 204 1910, 200 1864, 160 1858" />
            <path pathLength="1" style="--d:1.8s;--dur:.5s" stroke="#f5a524" stroke-width="6" d="M470 1650 C 380 1720, 260 1820, 194 1868 M222 1870 L192 1872 L206 1846" />
          </svg>
          <p class="note" style="left:48%;top:19%;--d:.8s;--rot:-2deg">{t('ch6.note.fires')}</p>
          <p class="note" style="left:30%;top:79.5%;--d:2s;--rot:-3deg">{t('ch6.sk.note')}</p>
          <svg class="doodle" viewBox="40 30 470 210" aria-hidden="true">
            <g class="ink" stroke="#ece7d8" stroke-width="3">
              <path pathLength="1" style="--d:.1s;--dur:1.4s" d="M150 40 C 90 50, 64 120, 100 166 C 132 206, 196 204, 226 170 C 186 178, 140 156, 130 112 C 122 76, 132 52, 150 40 Z" />
              <path pathLength="1" style="--d:1s;--dur:.4s" d="M300 50 l6 0 M303 47 l0 6 M262 120 l5 0 M264 117 l0 5" />
            </g>
            <g class="ink" stroke="#4daafc" stroke-width="3.2">
              <path pathLength="1" style="--d:.8s" d="M420 70 C 470 70, 496 110, 492 150 C 488 196, 450 222, 412 220 C 368 218, 340 186, 342 144 C 344 100, 376 70, 420 70 Z" />
              <path pathLength="1" style="--d:1.6s;--dur:.5s" d="M418 146 L418 102 M418 146 L392 168" />
            </g>
          </svg>
        </figure>
      </Chapter>
    </div>
  </div>

  <section class="little" id="little" aria-labelledby="little-h">
    <div class="wrap" data-reveal>
      <T k="little.title" as="h2" id="little-h" />
      <T k="little.lede" as="p" class="sub" />
      <ul class="things">
        {little.map((k) => (
          <li><b>{t(`little.${k}.t`)}</b><span>{t(`little.${k}.d`)}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="get" id="get" aria-labelledby="get-h">
    <div class="wrap">
      <T k="get.title" as="h2" id="get-h" />
      <T k="get.lede" as="p" class="lede" />
      <div class="get-grid">
        <div class="get-col">
          <h3><img src={`${base}brand/supraman.svg`} alt="" width="40" height="40" />{t('get.sm.name')}</h3>
          <p class="meta">{t('get.sm.meta')}</p>
          <ol>
            <li>{t('get.sm.s1')}</li>
            <li>{t('get.sm.s2')}</li>
            <li>{t('get.sm.s3')}</li>
          </ol>
          <p class="req">{t('get.sm.req')}</p>
          <a class="btn primary" href="https://github.com/getsupraman/supraman/releases/latest">{t('get.sm.cta')}</a>
        </div>
        <div class="get-col">
          <h3><img src={`${base}brand/workman.svg`} alt="" width="40" height="40" />{t('get.wm.name')}</h3>
          <p class="meta">{t('get.wm.meta')}</p>
          <p>{t('get.wm.s1')}</p>
          <pre><code>{t('get.wm.code1')}
{t('get.wm.code2')}</code></pre>
          <p>{t('get.wm.s2')}</p>
          <pre><code>{t('get.wm.code3')}</code></pre>
          <p class="req">{t('get.wm.req')}</p>
          <a class="btn ghost" href="https://github.com/getsupraman/workman">{t('get.wm.cta')}</a>
        </div>
      </div>
      <div class="star">
        <a class="btn ghost" href="https://github.com/getsupraman">{t('get.star')}</a>
      </div>
    </div>
  </section>
</Base>
